# APP
#--------------------------------------------------------------------

# CATATAN: url aplikasi ditentukan app.folder, bukan app.baseURL.
# Config\App::__construct() menyusun baseURL dari host request + app.folder,
# jadi app.folder-lah yang menentukan url — termasuk url callback SSO.
#
#   lokal       app.folder = '/sys-modern/'  -> http://localhost/sys-modern/
#   staging     app.folder = 'sys'           -> https://staging.transporindo.com/sys/
#   production  app.folder = ''              -> https://sys.transporindo.com/
#
# Untuk production di root domain, app.folder WAJIB ada dan bernilai kosong.
# Menghapus barisnya sama sekali membuatnya jatuh ke default lama 'sys-modern'.
#
# Host di luar daftar tidak lagi bisa menyetir url yang dikirim aplikasi (link reset
# password, callback SSO), dan aplikasi memakai app.baseURL sebagai gantinya.
# Kosongkan barisnya untuk memakai bawaan: sys.transporindo.com,
# staging.transporindo.com, localhost, 127.0.0.1. Host milik app.baseURL selalu
# ikut diizinkan. Isi baris ini kalau server memakai domain lain.
# app.allowedHostnames = 'sys.transporindo.com, staging.transporindo.com'
#
# Dipakai saat host request tidak dikenal — isi sesuai url resmi server ini.
# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Versi aplikasi yang tampil di kaki sidebar. Kalau baris ini tidak diisi,
# dipakai nilai cadangan di Config\App::$version.
# app.version = '2.0.0'

# Proxy yang boleh menyetir X-Forwarded-Proto dan X-Forwarded-For, berisi IP
# atau subnet CIDR yang dipisah koma. Tanpa baris ini yang dipercaya hanya
# loopback (127.0.0.1, ::1) -- cukup untuk cloudflared atau web server yang
# jalan di mesin yang sama.
#
# WAJIB benar kalau TLS diputus di depan aplikasi (tunnel Cloudflare, reverse
# proxy): selama proxy-nya tidak terdaftar, CodeIgniter menganggap koneksinya
# tidak aman, sehingga cookie.secure = true berujung SecurityException
# "Attempted to send a secure cookie over a non-secure connection" dan setiap
# pengguna tercatat ber-IP proxy -- throttle login dan audit trail jadi salah
# sasaran. Kosongkan (app.proxyIPs = '') kalau aplikasi melayani internet
# langsung tanpa proxy.
# app.proxyIPs = '127.0.0.1, ::1'

# Header yang dibaca sebagai IP pengunjung (bawaan X-Forwarded-For).
# Di belakang Cloudflare isi CF-Connecting-IP: Cloudflare MENAMBAHKAN ip asli
# ke rantai X-Forwarded-For yang dikirim pengunjung sementara framework
# mengambil entri pertama, jadi lewat XFF pengunjung bisa memilih sendiri ip
# yang tercatat di throttle login dan audit trail. CF-Connecting-IP selalu
# ditulis ulang Cloudflare.
# app.proxyHeader = 'CF-Connecting-IP'

# Cookie sesi hanya dikirim lewat HTTPS. WAJIB true di staging dan production
# (keduanya HTTPS); biarkan false untuk pengembangan lokal di http://localhost.
# cookie.secure = true

