# SECURITY
#--------------------------------------------------------------------

# Penegakan ACL (App\Filters\AclFilter).
#   true  = request tanpa hak akses ditolak dengan HTTP 403 (default)
#   false = hanya dicatat sebagai "ACL WOULD-DENY" di writable/logs,
#           request tetap diteruskan. Pakai ini saat transisi untuk
#           menemukan baris tblacos yang masih kurang.
# security.aclEnforce = true

#--------------------------------------------------------------------
# SSO (auth-sso / auth-sso-api)
#--------------------------------------------------------------------
# Dibaca app/Config/Sso.php. sys-modern berperan sebagai aplikasi anggota:
# auth-sso-api yang menerbitkan tiket, sys-modern hanya memverifikasinya.
# Lihat dokumentasi_sso.md untuk alur lengkap dan cara mendaftarkan aplikasi.

# sso.enabled = false

# Kode aplikasi ini di sisi SSO. Harus sama dengan key di TICKET_RELAY_APPS
# (auth-sso-api) dan `code` kartu SYS di constants/apps.ts (auth-sso).
# sso.appCode = sys
# sso.issuer = auth-sso

# PUBLIC key RS256 milik SSO — pasangan dari SSO_TICKET_PRIVATE_KEY di
# auth-sso-api. Boleh PEM utuh, boleh badan base64 satu baris dengan newline
# ditulis \n. Tulis TANPA tanda kutip. JANGAN pernah menaruh private key di sini.
# sso.ticketPublicKey =

# Toleransi selisih jam (detik) dan umur simpan nonce jti. nonceTtl harus lebih
# panjang dari TICKET_TTL_SECONDS di auth-sso-api + leeway.
# sso.leeway = 60
# sso.nonceTtl = 300

# Dashboard auth-sso dan base URL auth-sso-api.
# sso.dashboardUrl =
# sso.apiBaseUrl =

# Secret bersama endpoint Single Logout (header x-slo-secret). WAJIB sama persis
# dengan SLO_INTROSPECT_SECRET di auth-sso-api.
# sso.sloSecret =
# sso.sloPollSeconds = 60

# Identitas pada tiket yang dicocokkan ke tbluser.
# sso.matchClaim = email
# sso.matchColumn = email

# Saklar login lokal (userid/password + reset password). Set false hanya setelah
# SSO terbukti jalan: false berarti SSO satu-satunya jalan masuk ke sys.
# sso.passwordLoginEnabled = true
